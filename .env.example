# DTFLEXPRO — cópia de exemplo das variáveis de ambiente.
# Copie para `.env` e preencha os valores de produção:
#   cp .env.example .env

# ------------------------------------------------------------------
# Supabase (públicos — seguros no repositório)
# ------------------------------------------------------------------
SUPABASE_PROJECT_ID="seu-projeto"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJ..." # chave anon/publishable (pública por definição)
VITE_SUPABASE_PROJECT_ID="seu-projeto"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."

# ------------------------------------------------------------------
# OBRIGATÓRIAS no servidor (NUNCA commite os valores reais)
# ------------------------------------------------------------------
# Segredo usado para assinar os cookies de sessão (admin + acesso).
# Gere um: openssl rand -hex 32
SESSION_SECRET=""

# Chave service_role do Supabase (Settings → API). Usada somente nas
# server functions (login, catálogo, biblioteca, gestão).
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------
# Opcionais conforme os recursos utilizados
# ------------------------------------------------------------------
# URL pública do app (links de e-mail/checkout). Ex.: https://www.dtflexpro.com
APP_URL=""

# Painel administrativo (verificação de senha extra).
ADMIN_MASTER_PASSWORD=""

# Resend — envio de e-mails (fila de trial/assinatura).
RESEND_API_KEY=""

# Gateways de pagamento.
STRIPE_WEBHOOK_SECRET=""
INFINITEPAY_WEBHOOK_SECRET=""

# Geração de imagens por IA (Removedor/mocking via Lovable AI Gateway).
LOVABLE_API_KEY=""
