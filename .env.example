# Copie para .env / .env.development / .env.production e preencha.
# Os arquivos .env reais do dtflex.zip NAO foram enviados ao GitHub
# (repositorio publico) - eles ficam apenas na maquina/ambiente local.

# --- Supabase (cliente + servidor) - vinham no .env original ---
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Pagamentos (cliente) - vinha no .env.development / .env.production ---
# development usa pk_test_... / production usa pk_live_...
VITE_PAYMENTS_CLIENT_TOKEN=

# --- Somente servidor (NUNCA expor no navegador nem commitar) ---
# O zip original NAO trazia estas chaves: elas vivem no ambiente
# de hospedagem (Lovable/Cloudflare). Sem elas, login por codigo,
# checkout/webhooks, e-mails e funcoes admin nao funcionam.
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=
ADMIN_MASTER_PASSWORD=
APP_URL=
RESEND_API_KEY=
LOVABLE_API_KEY=
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
