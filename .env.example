# DTFLEXPRO — cópia de exemplo das variáveis de ambiente.
# Copie para `.env` e preencha os valores de produção:
#   cp .env.example .env

# ------------------------------------------------------------------
# Supabase (públicos — seguros no repositório)
# ------------------------------------------------------------------
SUPABASE_PROJECT_ID="seu-projeto"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_PUBLISHABLE_KEY="eyJ..." # chave anon/publishable (pública por definição)
VITE_SUPABASE_PROJECT_ID="seu-projeto"
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJ..."

# ------------------------------------------------------------------
# OBRIGATÓRIAS no servidor (NUNCA commite os valores reais)
# ------------------------------------------------------------------
# Segredo usado para assinar os cookies de sessão (admin + acesso).
# Gere um: openssl rand -hex 32
SESSION_SECRET=""

# Chave service_role do Supabase (Settings → API). Usada somente nas
# server functions (login, catálogo, biblioteca, gestão).
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------
# Opcionais conforme os recursos utilizados
# ------------------------------------------------------------------
# URL pública do app (links de e-mail/checkout). Ex.: https://www.dtflexpro.com
APP_URL=""

# Painel administrativo.
# Se ficar vazio, vale a senha master de reserva gravada em hash no código
# (src/lib/access.functions.ts → ADMIN_MASTER_HASH).
# Preenchida aqui, ela TEM PRIORIDADE sobre o hash.
ADMIN_MASTER_PASSWORD=""

# Resend — envio de e-mails (fila de trial/assinatura).
RESEND_API_KEY=""

# Gateways de pagamento.
STRIPE_WEBHOOK_SECRET=""
INFINITEPAY_WEBHOOK_SECRET=""

# Geração de imagens por IA (Removedor/mocking via Lovable AI Gateway).
LOVABLE_API_KEY=""

# ------------------------------------------------------------------
# Pagamentos (Stripe via gateway Lovable)
# ------------------------------------------------------------------
# Token público do Stripe (pk_test_... para testes, pk_live_... em produção).
# Sem ele a tela /pagamento entra em modo de teste/aviso.
VITE_PAYMENTS_CLIENT_TOKEN=""
# Chave usada no servidor para criar a sessão de checkout.
LOVABLE_API_KEY=""
# Segredo do webhook do Stripe (api/public/payments/webhook).
STRIPE_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# E-mails transacionais
# ------------------------------------------------------------------
# Endpoint de envio (fila de e-mails). Ex.: https://api.resend.com/emails
LOVABLE_SEND_URL=""
# Chave pública do Supabase exposta ao servidor (mesma anon/publishable).
SUPABASE_PUBLISHABLE_KEY=""
# URL base canônica usada em links de e-mail/checkout.
URL=""
